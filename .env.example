# ---------------------------------------------------------------------------
# PRODUCTION — copy to .env.local (gitignored) and fill in. Placeholders only
# here; real values never go in git.
#
# The same variables are set on Render (render.yaml). lib/env.ts validates
# them at startup: the server refuses to start on a missing or invalid one.
#
# `npm run dev` also reads .env.local, but .env.development.local wins — keep
# that file so the dev server talks to the local database, not to this one.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres 17) ---------------------------------------
# App connection: TRANSACTION pooler, port 6543. ?pgbouncer=true is required.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations only: SESSION pooler, port 5432. Used by npm run db:prod:migrate
# and by the Render pre-deploy step; the app never uses it.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- The site -----------------------------------------------------------------
# Public origin: absolute urls in OpenGraph tags and canonical links.
SITE_URL=https://careers.example.com

# --- Supabase project ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- File storage (résumés) ---------------------------------------------------
# Production must use Supabase Storage, in a PRIVATE bucket (create it in the
# Supabase dashboard: Storage › New bucket › name "applications", Public OFF).
STORAGE_DRIVER=supabase
STORAGE_BUCKET=applications
# The SECRET key (sb_secret_… or the legacy service_role key). Server only —
# never prefix it NEXT_PUBLIC_: it can read every résumé.
SUPABASE_SERVICE_ROLE_KEY=

# --- Spam protection on the application form (optional) ------------------------
# Cloudflare Turnstile. Both empty = off; set both to turn it on.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Visitor IP, for the per-IP limit on applications ----------------------------
# Behind Cloudflare -> Render. Measure the real hop count on the deployment
# (log X-Forwarded-For once and count) — see render.yaml.
TRUST_PROXY_HEADER=X-Forwarded-For
TRUST_PROXY_HOPS=3

# --- HR's Google Sheet (optional) ------------------------------------------------
# The old Apps Script webhook: one row per application. Both empty = off.
APPLY_SHEET_WEBHOOK_URL=
APPLY_SHEET_API_KEY=

# --- Admin sign-in: SHD SSO (central login) ----------------------------------
# SSO is on when SSO_CLIENT_ID and SSO_CLIENT_SECRET are both set (and
# SESSION_SECRET). Both empty = the admin answers 503 in production.
# Register this redirect URI for the app in the central console, exactly:
#   <SITE_URL>/api/sso/callback
# Client id and secret: issued when SSO is switched on for the app (the secret
# is shown once).
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Ours, not the SSO service's: signs the admin's session cookie. 32+ random
# characters — generate with: openssl rand -base64 48
SESSION_SECRET=
# The central permission API key — from the app's Credentials page, NOT the
# client secret. Empty = everyone who can sign in may do everything (a warning
# is logged). Resources to register: sso-schema/resources.csv.
CENTRAL_API_KEY=
# Default https://sso.shd-technology.co.th — set only to use another one.
SSO_ORIGIN=
# Setting up only: log what /sso/verify answers. "shape" = names and types,
# no personal data. Leave empty normally.
SSO_DEBUG=

# --- Error reporting (optional) --------------------------------------------
# Empty = Sentry is off and nothing is sent anywhere. To turn it on: create a
# Sentry project, paste its DSN here and on Render, redeploy. No code change.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Browser errors. Read at BUILD time, so set it on Render before the build.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# --- Time zone (company standard: OS, app and DB all Asia/Bangkok) -----------
# Required — the server does not start without it. The DB's zone is set by
# migration 0004; check all three at /api/v1/health or npm run check:timezone.
TZ=Asia/Bangkok

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
