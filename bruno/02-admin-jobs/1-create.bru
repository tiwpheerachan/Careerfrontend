meta {
  name: Create a job
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/jobs
  body: json
  auth: none
}

body:json {
  {
    "code": "BRUNO-{{$timestamp}}",
    "countryCode": "TH",
    "department": "Testing",
    "level": "Entry Level",
    "quantity": 1,
    "translations": {
      "th": { "title": "ตำแหน่งทดสอบจาก Bruno", "location": "กรุงเทพฯ" },
      "en": { "title": "Bruno test job", "location": "Bangkok" }
    }
  }
}

assert {
  res.status: eq 201
  res.body.job.publishState: eq DRAFT
}

script:post-response {
  bru.setVar("jobId", res.getBody().job.id);
  bru.setVar("jobCode", res.getBody().job.code);
}
