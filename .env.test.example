# ---------------------------------------------------------------------------
# Tests — optional. Copy to .env.test.local only to point the suite somewhere
# other than the default below. Never at Supabase: the suite truncates every
# table between tests, and tests/support/db.ts refuses a supabase.co url.
#
#   npm run db:test:up   # postgres:17, container shd-career-test, wiped each start
#   npm test
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55435/shd_career_test
