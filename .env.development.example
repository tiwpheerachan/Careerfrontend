# ---------------------------------------------------------------------------
# Local development — copy to .env.development.local (gitignored).
#
#   cp .env.development.example .env.development.local
#   npm run db:dev:up        # postgres:17 in Docker, container shd-career-dev
#   npm run db:dev:migrate
#   npm run dev
#
# `npm run dev` reads this file AFTER .env.local and these values win, so the
# dev server talks to the local database below instead of production. The
# db:dev:* scripts read only this file, and refuse to run if it points at
# anything but this machine.
#
# The values match docker-compose.yml's defaults.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://root:dev_pass@127.0.0.1:55434/shd_career_db_dev
DIRECT_URL=postgresql://root:dev_pass@127.0.0.1:55434/shd_career_db_dev

LOG_LEVEL=debug

# Uploaded files go to ./.storage (gitignored). Development never touches
# Supabase — not the database, not the bucket.
STORAGE_DRIVER=local

# Off in development: no Turnstile, no Google Sheet.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
APPLY_SHEET_WEBHOOK_URL=

# Sentry stays off in development.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
